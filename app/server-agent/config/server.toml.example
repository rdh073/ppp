# server-agent configuration file
#
# Override chain (lowest → highest priority):
#   built-in defaults  →  this file  →  environment variables  →  CLI flags
#
# Secrets: prefer environment variables for production deployments.
#   AUTO_REDIS_PASSWORD       — Redis authentication password (env only)
#   AUTO_ACCOUNT_DATABASE_URL — PostgreSQL DSN for account/persona persistence (env overrides account_store.database_url)
#   AUTO_LLM_<PROVIDER>_API_KEY — per-provider API keys (env overrides llm.providers.<provider>.api_key)
#
# Usage:
#   go run ./cmd/server -config ./config/server.toml

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
[server]
# addr = ":3000"

# Persistent runtime data directory (tasks, workflow checkpoints, events).
# data_dir = "./var"

# Tool catalog directory. Must contain providers.yaml + manifests/ subdirectory.
# tool_dir = "./config/tools"

# Workflow definitions directory. Leave empty for in-memory-only workflow defs.
# workflow_dir = ""

# How often to reload workflow definitions from workflow_dir (if set).
# workflow_poll = "5s"

# Log verbosity: debug | info | warn | error
# log_level = "info"

# Graceful shutdown window before the process exits.
# shutdown_timeout = "15s"

# ---------------------------------------------------------------------------
# State store
# ---------------------------------------------------------------------------
[store]
# driver = "file"      # "file" | "redis"

# Redis-only: how long task and workflow-state keys live. 0 = no expiry.
# state_ttl = "0s"

# ---------------------------------------------------------------------------
# Redis connection (used by store.driver = "redis" and event_runtime.mode = "redis-streams")
# ---------------------------------------------------------------------------
[redis]
# addr = "localhost:6379"
# db   = 0
# Password: AUTO_REDIS_PASSWORD environment variable only.

# ---------------------------------------------------------------------------
# Event runtime
# ---------------------------------------------------------------------------
[event_runtime]
# mode = "inline"   # "inline" | "redis-streams"
#
# inline:         accept → process in-process immediately (development / single-node)
# redis-streams:  accept → publish to Redis Streams → worker goroutines consume

# ---------------------------------------------------------------------------
# Event bus (redis-streams mode only)
# ---------------------------------------------------------------------------
[event_bus]
# partitions      = 8       # Number of wakeup stream partitions (workflow.wakeup.pNN)
# group           = "server-agent"
# consumer_prefix = "server-agent"
# instance_id     = ""      # Stable worker identity; auto-generated when empty
# lease_ttl       = "15s"   # Partition ownership lease TTL
# pending_idle    = "45s"   # Minimum idle before reclaiming stuck pending entries
# claim_count     = 16      # Max pending entries reclaimed per XAUTOCLAIM call
# ownership_retry = "500ms" # Backoff before retrying partition ownership

# ---------------------------------------------------------------------------
# Periodic pruning (prevent unbounded file-store growth)
# ---------------------------------------------------------------------------
[pruning]
# interval            = "1h"    # How often the pruner runs
# accepted_events_age = "168h"  # Prune accepted events older than this (7 days)
# dead_letters_age    = "168h"  # Prune dead letters older than this (7 days)
# command_outbox_age  = "24h"   # Prune command outbox records older than this

# ---------------------------------------------------------------------------
# Account & Persona store (optional PostgreSQL persistence)
# ---------------------------------------------------------------------------
[account_store]
# driver = "file"   # "file" | "postgres"
#
# file:     accounts and personas persisted to JSON files in data_dir (default)
# postgres: accounts and personas persisted to PostgreSQL
#
# When driver = "postgres", provide the DSN:
# database_url = "postgres://user:pass@localhost:5432/ppp"
#
# Prefer env var for production: AUTO_ACCOUNT_DATABASE_URL
# Tables are auto-created on first startup (IF NOT EXISTS).

# ---------------------------------------------------------------------------
# ADB (Android Debug Bridge) — accessibility auto-enabler
# ---------------------------------------------------------------------------
[adb]
# host                    = "localhost"
# port                    = 5037
# accessibility_component = "com.autosdk.agent/com.autosdk.agent.service.AgentAccessibilityService"

# Optional per-device serial overrides. Maps deviceId → adb serial.
# [adb.serial_by_device]
# "emulator-pixel7" = "emulator-5554"
# "real-device-01"  = "R58M41XXYYY"

# ---------------------------------------------------------------------------
# Tool LLM backend (legacy; model-backed tools such as vision.analyze)
# ---------------------------------------------------------------------------
[tools.llm]
# OpenAI-compatible chat-completions endpoint (used by builtin tool provider).
# api_url = "https://api.openai.com/v1/chat/completions"
# model   = "gpt-4o"
# api_key = ""   # overridden by AUTO_TOOL_LLM_API_KEY env var (env takes precedence)

# ---------------------------------------------------------------------------
# LLM Provider Registry
# ---------------------------------------------------------------------------
# Define provider credentials once. Each concern below references a provider
# by key. Env override pattern: AUTO_LLM_<PROVIDER>_API_KEY, AUTO_LLM_<PROVIDER>_MODEL, etc.
#
# Legacy env vars (AUTO_TOOL_OPENAI_API_KEY, AUTO_TOOL_ANTHROPIC_API_KEY, etc.)
# are still read as fallbacks if the new config is not set.

# [llm.providers.openai]
# api_url = "https://api.openai.com/v1/chat/completions"
# api_key = ""
# model   = "gpt-4o-mini"

# [llm.providers.anthropic]
# api_url     = "https://api.anthropic.com/v1/messages"
# api_key     = ""
# model       = "claude-sonnet-4-20250514"
# api_version = "2023-06-01"

# [llm.providers.deepseek]
# api_url = "https://api.deepseek.com/chat/completions"
# api_key = ""
# model   = "deepseek-chat"

# [llm.providers.gemini]
# api_url = "https://generativelanguage.googleapis.com/v1beta"
# api_key = ""
# model   = "gemini-2.0-flash"

# ---------------------------------------------------------------------------
# LLM Concerns — each picks a provider from the registry above
# ---------------------------------------------------------------------------

# AI-driven recording loop provider.
# [llm.agent_loop]
# provider = "anthropic"

# Caption/content text generation. Supports fallback chain.
# [llm.text_generation]
# provider = "anthropic"
# fallback = "openai"        # optional: try if primary fails

# Image generation (DALL-E 3).
# [llm.image_generation]
# provider = "openai"

# Vision analysis (captcha solving, image inspection).
# [llm.vision]
# provider = "anthropic"

# Tool catalog (leave empty to use providers.yaml as-is).
# [llm.tool_catalog]
# provider = ""
